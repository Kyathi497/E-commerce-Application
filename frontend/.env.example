# Razorpay keys (Dashboard → Account & Settings → API Keys).
# Leave empty to run the store in test mode (simulated payments, no charges).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs login sessions. Any long random string, e.g. `openssl rand -base64 32`.
# Leave empty in test mode and one is generated in .data/ automatically.
AUTH_SECRET=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback for dev).
# Leave empty to run Google sign-in in test mode (simulated, clearly labelled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set only if the redirect URI above differs from this site's own address (e.g. behind a proxy).
GOOGLE_REDIRECT_URI=
